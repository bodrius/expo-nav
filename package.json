{
  "name": "expo-nav",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@shopify/flash-list": "^2.3.1",
    "expo": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-navigation": "^8.8.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "check:diff": "git diff --cached --check",
    "check": "yarn check:diff && yarn lint && yarn typecheck && yarn test",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/flash-list)"
    ]
  },
  "private": true
}
